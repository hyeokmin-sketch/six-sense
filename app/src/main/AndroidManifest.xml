<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 음성 인식(SpeechRecognizer)용. 보드 연동 전까지 폰 마이크로 데모 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Orange Pi 로컬 서버(FastAPI) 호출용 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SixSenseApp"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SixSense">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    
        <activity
            android:name=".ui.listen.ListenActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.devices.DeviceDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>