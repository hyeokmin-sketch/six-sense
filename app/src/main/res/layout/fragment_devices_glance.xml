<?xml version="1.0" encoding="utf-8"?>
<!-- 한눈에 모드 기기 목록. 한 줄에 하나, 이름과 ON/OFF를 크게. 누르면 상세 화면 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="24dp">

    <TextView
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/devices_title" />

    <TextView
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/devices_subtitle"
        android:textSize="@dimen/text_body_small" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/group_rooms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_room_all"
            style="@style/RoomChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/room_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_room_living"
            style="@style/RoomChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_living" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_room_kitchen"
            style="@style/RoomChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_kitchen" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_room_bath"
            style="@style/RoomChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_bath" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:scrollbars="vertical" />
</LinearLayout>
