<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- 상단: 홈으로 / 듣는 중 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/button_back"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:text="@string/listen_back"
            android:textSize="@dimen/text_body"
            app:drawableStartCompat="@drawable/ic_chevron_left"
            app:drawableTint="@color/muted" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_listening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/listen_listening"
            android:textColor="@color/rose"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 들은 말 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            style="@style/Text.SectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/listen_heard_label" />

        <TextView
            android:id="@+id/text_heard"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            tools:text="“불 좀 꺼주이소”" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_understood_label"
        style="@style/Text.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/listen_understood"
        android:textSize="@dimen/text_body_small"
        app:drawableStartCompat="@drawable/ic_arrow_down"
        app:drawableTint="@color/muted" />

    <!-- 이해한 뜻 카드. 되묻기일 때는 질문이 여기 들어간다 -->
    <LinearLayout
        android:id="@+id/card_interpretation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_accent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_device"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_tint"
                android:contentDescription="@null"
                android:padding="12dp"
                android:src="@drawable/ic_bulb"
                app:tint="@color/rose" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_summary"
                    style="@style/Text.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="거실 조명 끄기" />

                <TextView
                    android:id="@+id/text_dialect"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="@dimen/text_body_small"
                    tools:text="‘꺼주이소’ → ‘꺼 주세요’ (경상도)" />
            </LinearLayout>
        </LinearLayout>

        <!-- 말투 / 확신도 / 상황 태그 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/group_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="0dp" />
    </LinearLayout>

    <!-- 되묻기일 때 안내 문장 (평소엔 숨김) -->
    <TextView
        android:id="@+id/text_ask_back"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_tint"
        android:padding="14dp"
        android:textColor="@color/rose_deep"
        android:visibility="gone"
        tools:text="어느 방 불 말씀이세요?"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 카운트다운 -->
    <LinearLayout
        android:id="@+id/group_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_countdown"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/text_body_small"
                tools:text="3초 뒤 자동으로 실행해요" />

            <TextView
                android:id="@+id/text_countdown_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_small"
                android:textStyle="bold"
                tools:text="2초" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_countdown"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_countdown"
            tools:progress="660" />
    </LinearLayout>

    <Button
        android:id="@+id/button_run"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:layout_marginTop="16dp"
        android:drawablePadding="8dp"
        android:text="@string/listen_run_now"
        app:drawableStartCompat="@drawable/ic_check"
        app:drawableTint="@color/white" />

    <Button
        android:id="@+id/button_cancel"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="10dp"
        android:text="@string/listen_cancel" />

    <Button
        android:id="@+id/button_retry"
        style="@style/Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/listen_retry" />

</LinearLayout>
