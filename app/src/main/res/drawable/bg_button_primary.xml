<?xml version="1.0" encoding="utf-8"?>
<!-- 주요 버튼: 시안과 같은 로즈 그라데이션 (왼쪽 위가 밝음) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#DA7690"
                android:centerColor="@color/rose" android:endColor="#B4455F" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
