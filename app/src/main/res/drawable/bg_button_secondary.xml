<?xml version="1.0" encoding="utf-8"?>
<!-- 보조 버튼: 유리 (반투명 흰 + 흰 테두리) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/rose_tint">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D9FFFFFF" android:endColor="#B3FFFFFF" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/glass_edge" />
        </shape>
    </item>
</ripple>
