<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SixSense" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rose</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/rose_tint</item>
        <item name="colorOnPrimaryContainer">@color/rose_deep</item>
        <item name="colorSecondary">@color/rose_deep</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/Dialog.SixSense</item>
    </style>

    <!-- 팝업: 카드와 같은 둥근 모서리. 확인(켜기)은 청록, 아니요는 주홍 -->
    <style name="Dialog.SixSense" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.SixSense.Dialog</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Dialog.SixSense.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Dialog.SixSense.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Dialog.SixSense.ButtonYes</item>
        <item name="buttonBarNegativeButtonStyle">@style/Dialog.SixSense.ButtonNo</item>
        <item name="buttonBarNeutralButtonStyle">@style/Dialog.SixSense.ButtonNo</item>
    </style>
    <style name="ShapeAppearance.SixSense.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/card_radius</item>
    </style>
    <style name="Dialog.SixSense.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Dialog.SixSense.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>
    <style name="Dialog.SixSense.ButtonYes" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/state_on</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Dialog.SixSense.ButtonNo" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/state_off</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- 카드 공통 -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- 글자 스타일 -->
    <style name="Text.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Heading" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Subheading" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_subheading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink_soft</item>
    </style>
    <style name="Text.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="Text.SectionLabel" parent="TextAppearance.AppCompat">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- 버튼 -->
    <style name="Button.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Button.Secondary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Button.Text" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 하단 탭 선택 표시 -->
    <style name="BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/rose_tint</item>
    </style>

    <!-- 홈 화면 예시 말투 칩 -->
    <style name="ExampleChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">14sp</item>
        <item name="chipMinHeight">36dp</item>
    </style>

    <!-- 기기 제어 화면 방 필터 칩 -->
    <style name="RoomChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/room_chip_bg</item>
        <item name="chipStrokeColor">@color/room_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/room_chip_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- 설정 화면 -->
    <style name="SegmentButton">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="SettingsRow.Label">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="SettingsRow.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="SettingsRow.Chevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="tint">@color/muted</item>
    </style>
    <style name="ModeRadio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="buttonTint">@color/rose</item>
    </style>
    <style name="ModeRadio.Desc" parent="Text.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">48dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginTop">-6dp</item>
    </style>
    <style name="PrivacyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="PrivacyRow.Key" parent="Text.Caption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_body_small</item>
    </style>
    <style name="PrivacyRow.Value" parent="Text.Body">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- 홈: 자주 쓰는 말 버튼. 글자 크게 -->
    <style name="FrequentButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 홈: 에어컨 / 보일러 선택. 강조는 코드에서 글자 크기·굵기·배경을 바꾼다 -->
    <style name="ChoiceButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 홈: 에어컨/보일러 상태 타일 (이름 + ON/OFF 두 줄). 배경·투명도는 코드에서 -->
    <style name="StateTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 상세 화면: 세로로 쌓이는 선택 줄 (밝기 프리셋, 오븐 예시, 커피 메뉴). 선택되면 코드에서 채움 -->
    <style name="PresetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_choice</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- 오븐 +5분 / +10분 / +30분 -->
    <style name="TimeButton" parent="ChoiceButton">
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
